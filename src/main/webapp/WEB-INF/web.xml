<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>HypnoElectronic - SENA</display-name>
    <description>Proyecto para evidencia GA7-220501096-AA5-EV03</description>

    <!-- SERVLETS DE API -->
    <servlet>
        <servlet-name>AuthAPIServlet</servlet-name>
        <servlet-class>com.hypnoelectronic.api.AuthAPIServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthAPIServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductosAPIServlet</servlet-name>
        <servlet-class>com.hypnoelectronic.api.ProductosAPIServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductosAPIServlet</servlet-name>
        <url-pattern>/api/products/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UsuariosAPIServlet</servlet-name>
        <servlet-class>com.hypnoelectronic.api.UsuariosAPIServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UsuariosAPIServlet</servlet-name>
        <url-pattern>/api/users/*</url-pattern>
    </servlet-mapping>

    <!-- PÁGINA DE INICIO -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- CONFIGURACIÓN DE SESIÓN -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>